// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  ad          String
  email       String    @unique
  sifreHash   String
  role        String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
}
model Category {
  id        String    @id @default(uuid())
  ad        String    @unique
  aciklama  String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  products  Product[]
}

model Product {
  id              String    @id @default(uuid())
  ad              String
  sku             String    @unique
  aciklama        String?
  birim           String    @default("adet")
  fiyat           Float
  stokMiktari     Int       @default(0)
  minStokSeviyesi Int       @default(0)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
}