# Veritabanı (PostgreSQL). Docker Compose kullanıyorsanız host "postgres" olur.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/depo_stok_db?schema=public"

# JWT imza anahtarları: üretimde mutlaka uzun, rastgele ve birbirinden farklı değerler kullanın
JWT_SECRET="degistir-access-secret"
JWT_REFRESH_SECRET="degistir-refresh-secret"

# API portu (tanımlı değilse 3000)
PORT=3000

# İzin verilen web adresleri (virgülle ayırın)
CORS_ORIGIN=http://localhost:3100

# Hız sınırı: IP başına dakikadaki istek sayısı (genel / giriş-yenileme uçları)
THROTTLE_LIMIT=300
AUTH_THROTTLE_LIMIT=20

# Ters vekil (nginx vb.) arkasındaysanız 1 yapın; gerçek IP X-Forwarded-For'dan okunur
# TRUST_PROXY=1
